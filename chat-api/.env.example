# Volcano Engine Ark — OpenAI-compatible (复用 monorepo 根 .env.local 的 key)
VOLCANO_API_KEY=ark-xxxxxxxxxxxx
VOLCANO_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
VOLCANO_MODEL=doubao-seed-2.0-pro

# Port (与 chinese-name 的 3001 错开)
PORT=3002

# Admin token — 用于 /admin/logs?token=xxx 鉴权（生产用强随机 32+ 字符）
# 生成：openssl rand -hex 32
ADMIN_TOKEN=replace-with-strong-random-token
