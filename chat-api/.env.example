# Qwen 直连，按实际百炼账号填写 key 与端点，不经 new-api。
# Coding Plan 的用途限制见阿里云官方说明；通用 API 可改用业务空间专属端点。
CHAT_LLM_API_KEY=replace-with-qwen-api-key
CHAT_LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
CHAT_LLM_MODEL=qwen3.7-plus

# RAG 审稿与脱敏复用上面的 key 和端点，模型分别可配置。
RAG_JUDGE_MODEL=qwen3.7-plus
RAG_SANITIZE_MODEL=qwen3.7-plus

# 保留现有 Ark embedding 与向量索引，独立于 Qwen 配置。
# 迁移前把原 CHAT_LLM_API_KEY / CHAT_LLM_BASE_URL 保留到这两个变量。
# 火山不可用时，在线对话在最多 5 秒的向量查询失败后使用空 context。
EMBED_LLM_API_KEY=replace-with-existing-embedding-key
EMBED_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# Port (与 chinese-name 的 3001 错开)
PORT=3002

# Admin token — 用于 /admin/logs?token=xxx 鉴权（生产用强随机 32+ 字符）
# 生成：openssl rand -hex 32
ADMIN_TOKEN=replace-with-strong-random-token
