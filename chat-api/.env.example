# 灵眸 OpenAI 兼容接口，使用允许调用对应模型的 API Key。
CHAT_LLM_API_KEY=replace-with-text-api-key
CHAT_LLM_BASE_URL=https://api.lmuai.com/v1
CHAT_LLM_MODEL=deepseek-flash

# RAG 审稿与脱敏复用文本 Key 和端点，模型分别可配置。
RAG_JUDGE_MODEL=deepseek-flash
RAG_SANITIZE_MODEL=deepseek-flash

# Embedding 须使用支持该能力的分组 Key，灵眸通用 Key 暂不支持。
# 独立凭证，不回退到文本 Key。改模型或维度必须同时重建索引。
EMBED_LLM_API_KEY=replace-with-embedding-group-key
EMBED_LLM_BASE_URL=https://api.lmuai.com/v1
EMBED_LLM_MODEL=qwen3.7-text-embedding
EMBED_LLM_DIMENSIONS=2048

PORT=3002

# 私有管理页 token，生产使用强随机值。生成：openssl rand -hex 32
ADMIN_TOKEN=replace-with-strong-random-token
