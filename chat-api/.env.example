# newapi-proxy 网关（自建中转站，聚合多上游 LLM 账号）
# 端点为 IP 直连 + 自签证书，必须关 SSL verify
CHAT_LLM_API_KEY=sk-xxxxxxxxxxxx
CHAT_LLM_BASE_URL=https://139.196.157.57/v1
CHAT_LLM_MODEL=doubao-seed-2.0-lite

# 关闭 Node 全局 SSL 校验 — newapi 走 IP 自签证书必须，切回域名时可删
NODE_TLS_REJECT_UNAUTHORIZED=0

# Port (与 chinese-name 的 3001 错开)
PORT=3002

# Admin token — 用于 /admin/logs?token=xxx 鉴权（生产用强随机 32+ 字符）
# 生成：openssl rand -hex 32
ADMIN_TOKEN=replace-with-strong-random-token
