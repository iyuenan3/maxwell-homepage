# 火山方舟 Ark — OpenAI 兼容直连（Coding Plan 端点）
# key 在火山 console 申请（ark- 前缀），需含 doubao-seed-2.0-* + doubao-embedding-vision 权限
CHAT_LLM_API_KEY=ark-xxxxxxxxxxxx
CHAT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CHAT_LLM_MODEL=deepseek-v4-flash
# 注：Ark 为公网有效证书，无需 NODE_TLS_REJECT_UNAUTHORIZED（仅 newapi IP 自签时代才需要）

# Port (与 chinese-name 的 3001 错开)
PORT=3002

# Admin token — 用于 /admin/logs?token=xxx 鉴权（生产用强随机 32+ 字符）
# 生成：openssl rand -hex 32
ADMIN_TOKEN=replace-with-strong-random-token
