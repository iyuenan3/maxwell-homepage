# Origin CA preview template, not ready for public browser-direct HTTPS.
# Provision a publicly trusted certificate before any shared gateway integration.
# Back up and validate the shared gateway before appending an approved route.
# Certificate files are private runtime artifacts, never committed.
http://maxwellii.com, http://www.maxwellii.com {
	redir https://maxwellii.com{uri} 301
}

https://maxwellii.com:443, https://www.maxwellii.com:443 {
	tls /data/maxwellii-origin/maxwellii.com.pem /data/maxwellii-origin/maxwellii.com.key
	reverse_proxy maxwellii-site:8080 {
		# Scope CDN trust to this new route, not the shared gateway globally.
		# Source: https://www.cloudflare.com/ips-v4/ and /ips-v6/ (2026-10-30).
		trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		flush_interval -1
		transport http {
			response_header_timeout 300s
		}
	}
}
